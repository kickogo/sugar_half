/**app.wxss**/

/* ==================== UI Design System: JENNY & FRIENDS ==================== */

/* ---------- Color Palette ---------- */
page {
  --bg-main: #FFF8E1;
  --primary-pink: #E8B86D;
  --active-red: #B8860B;
  --text-dark: #333333;
  --text-grey: #666666;
  --white: #FFFFFF;
  --vip-gold: #EAD1B3;

  /* ---------- Border, Radius & Shadow ---------- */
  --card-radius: 24rpx;
  --btn-radius: 16rpx;
  --border-thick: 4rpx solid #B8860B;
  --retro-shadow: 6rpx 6rpx 0rpx #B8860B;

  /* ---------- Typography ---------- */
  --font-family: "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;

  /* ---------- Global Resets ---------- */
  background-color: var(--bg-main);
  font-family: var(--font-family);
  color: var(--text-dark);
  box-sizing: border-box;
}

/* ---------- Container ---------- */
.container {
  min-height: 100vh;
  background-color: var(--bg-main);
}

/* ---------- Button Reset ---------- */
button {
  background: initial;
  padding: 0;
  margin: 0;
  border: none;
}

button::after {
  border: none;
}

/* ---------- Image ---------- */
image {
  display: block;
}

/* ---------- Global Active States (for clickable cards/buttons) ---------- */
.clickable:active {
  opacity: 0.85;
  transform: scale(0.97);
  transition: transform 0.1s ease, opacity 0.1s ease;
}

/* ---------- Interactive Element Active States ---------- */
.btn-primary:active,
.cart-icon-wrap:active,
.exchange-btn:active,
.settlement-btn:active,
.stepper-btn:active {
  opacity: 0.85;
  transform: scale(0.95);
  transition: transform 0.1s ease, opacity 0.1s ease;
}

/* ---------- Safe Area Padding Helper ---------- */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}