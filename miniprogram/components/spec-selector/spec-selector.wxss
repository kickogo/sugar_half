.selector-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.selector-container {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24px 24px 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.selector-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.selector-close {
  font-size: 48rpx;
  color: #999;
  padding: 8rpx;
}

.selector-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.spec-group {
  margin-bottom: 32rpx;
}

.spec-name {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  min-width: 140rpx;
  text-align: center;
  border: 2rpx solid transparent;
}

.spec-option text {
  font-size: 28rpx;
  color: #333;
}

.spec-option.selected {
  background: #e6f4ff;
  border-color: #1897f2;
}

.spec-option.selected text {
  color: #1897f2;
}

.spec-option.unavailable {
  opacity: 0.4;
}

.spec-option.unavailable text {
  color: #999;
}

.selector-footer {
  padding: 32rpx;
  border-top: 1rpx solid #eee;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1897f2;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}