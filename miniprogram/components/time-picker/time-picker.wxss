.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-container {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24px 24px 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
  padding: 8rpx;
}

.calendar {
  padding: 24rpx 32rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.calendar-nav {
  font-size: 40rpx;
  color: #666;
  padding: 16rpx 24rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.calendar-weekdays {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.calendar-weekdays text {
  width: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0;
  border-radius: 50%;
}

.calendar-day text {
  font-size: 28rpx;
  color: #333;
}

.calendar-day.disabled text {
  color: #ccc;
}

.calendar-day.selected {
  background: #1897f2;
}

.calendar-day.selected text {
  color: #fff;
}

.calendar-day.today {
  border: 2rpx solid #1897f2;
}

.time-slots {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.time-slots-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
}

.time-slots-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-slot {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  min-width: 140rpx;
  text-align: center;
}

.time-slot text {
  font-size: 26rpx;
  color: #333;
}

.time-slot.selected {
  background: #1897f2;
}

.time-slot.selected text {
  color: #fff;
}

.time-slot.unavailable {
  opacity: 0.4;
}

.picker-footer {
  padding: 32rpx;
  border-top: 1rpx solid #eee;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1897f2;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}