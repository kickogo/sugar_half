<view class="order-page">
  <navigation-bar title="订单详情" />

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{error}}" class="error">{{error}}</view>

  <view wx:else class="content">
    <!-- 订单状态 -->
    <view class="status-card">
      <text class="status-text">{{statusMap[orderDetail.status].text}}</text>
      <text class="order-no">订单号: {{orderDetail.order_no}}</text>
    </view>

    <!-- 用户信息 -->
    <view class="section">
      <view class="section-title">用户信息</view>
      <view class="info-row">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{orderDetail.user_id}}</text>
      </view>
    </view>

    <!-- 取货信息 -->
    <view class="section">
      <view class="section-title">取货信息</view>
      <view class="info-row">
        <text class="info-label">取货日期</text>
        <text class="info-value">{{orderDetail.reservation_date}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">取货时间</text>
        <text class="info-value">{{orderDetail.reservation_time}}</text>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-title">商品信息</view>
      <view wx:for="{{orderDetail.items}}" wx:key="sku_id" class="item-row">
        <view class="item-info">
          <text class="item-name">{{item.product_name}}</text>
          <text class="item-spec">{{item.sku_name}}</text>
        </view>
        <view class="item-price">
          <text class="price">¥{{formatPrice(item.price)}}</text>
          <text class="quantity">x{{item.quantity}}</text>
        </view>
      </view>
    </view>

    <!-- 订单金额 -->
    <view class="section">
      <view class="section-title">订单金额</view>
      <view class="amount-row">
        <text class="amount-label">总金额</text>
        <text class="amount-value">¥{{formatPrice(orderDetail.total_amount)}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view wx:if="{{orderDetail.remark}}" class="section">
      <view class="section-title">备注</view>
      <text class="remark">{{orderDetail.remark}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view wx:if="{{orderDetail.status === 1}}" class="action-btn primary" bindtap="onConfirmOrder">
        确认订单
      </view>
      <view wx:else class="action-btn disabled">
        {{statusMap[orderDetail.status].text}}
      </view>
    </view>
  </view>
</view>