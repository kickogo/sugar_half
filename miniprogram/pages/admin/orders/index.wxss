/* pages/admin/orders/index.wxss */
.orders-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #ff6b6b;
  border-bottom: 4rpx solid #ff6b6b;
}

.orders {
  padding: 20rpx;
}

.loading, .empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #666;
}

.order-status {
  font-size: 28rpx;
  font-weight: bold;
}

.order-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.order-user {
  font-size: 28rpx;
  color: #333;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.order-detail {
  display: flex;
  justify-content: space-between;
}

.order-time {
  font-size: 24rpx;
  color: #333;
}

.order-date {
  font-size: 24rpx;
  color: #999;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.action-btn {
  padding: 12rpx 30rpx;
  background: #ff6b6b;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}