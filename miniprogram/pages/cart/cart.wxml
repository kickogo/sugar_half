<!-- pages/cart/cart.wxml -->
<view class="container">
  <!-- 顶部配送通知 -->
  <view class="delivery-notice">
    <text class="notice-text">预计 05-24 11:00 开始配送</text>
  </view>

  <!-- 门店选择卡片 -->
  <view class="store-card">
    <view class="store-info">
      <text class="store-name">甜序（花样城店）</text>
      <text class="store-edit">编辑</text>
    </view>
  </view>

  <!-- 购物车列表 -->
  <view class="cart-list">
    <view class="cart-item clickable" wx:for="{{cartItems}}" wx:key="_id">
      <!-- 自定义 Checkbox -->
      <view class="custom-checkbox {{item.checked ? 'checked' : ''}}" bindtap="toggleCheck" data-id="{{item._id}}">
        <text class="check-icon" wx:if="{{item.checked}}">✓</text>
      </view>

      <!-- 商品图片 -->
      <image class="item-img" src="{{item.displayUrl || item.imageUrl}}" mode="aspectFill"></image>

      <!-- 商品信息 -->
      <view class="item-detail">
        <text class="item-name">{{item.name}}</text>
        <view class="item-spec">
          <text class="spec-text">{{item.spec}}</text>
        </view>
        <text class="item-price">¥{{item.price}}</text>
      </view>

      <!-- 数量加减器 -->
      <view class="quantity-stepper">
        <view class="stepper-btn minus" bindtap="decrease" data-id="{{item._id}}">-</view>
        <text class="stepper-num">{{item.quantity}}</text>
        <view class="stepper-btn plus" bindtap="increase" data-id="{{item._id}}">+</view>
      </view>
    </view>
  </view>

  <!-- 推荐商品 -->
  <view class="recommend-section">
    <view class="recommend-header">
      <view class="header-line"></view>
      <text class="header-title">推荐商品</text>
      <view class="header-line"></view>
    </view>
    <scroll-view class="recommend-scroll" scroll-x="true" white-space="nowrap">
      <view class="recommend-card clickable" wx:for="{{recommendItems}}" wx:key="_id">
        <image class="recommend-img" src="{{item.displayUrl || item.imageUrl}}" mode="aspectFill"></image>
        <text class="recommend-name">{{item.name}}</text>
        <text class="recommend-price">¥{{item.price}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 吸底结算栏 -->
  <view class="settlement-bar">
    <view class="settlement-left">
      <view class="custom-checkbox {{allChecked ? 'checked' : ''}}" bindtap="toggleAllCheck">
        <text class="check-icon" wx:if="{{allChecked}}">✓</text>
      </view>
      <text class="settlement-total">合计：<text class="total-price">¥{{totalPrice}}</text></text>
    </view>
    <view class="settlement-btn">
      <text class="btn-text">去结算({{selectedCount}})</text>
    </view>
  </view>
</view>