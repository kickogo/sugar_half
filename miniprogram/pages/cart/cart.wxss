/* pages/cart/cart.wxss */

/* ---------- 配送通知 ---------- */
.delivery-notice {
  background: rgba(226, 125, 154, 0.15);
  padding: 16rpx 40rpx;
}

.notice-text {
  font-size: 24rpx;
  color: var(--active-red);
  font-weight: bold;
}

/* ---------- 门店卡片 ---------- */
.store-card {
  margin: 20rpx 40rpx;
  padding: 24rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
}

.store-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.store-name {
  font-size: 28rpx;
  color: var(--text-dark);
  font-weight: bold;
}

.store-edit {
  font-size: 24rpx;
  color: var(--primary-pink);
  border: 2rpx solid var(--primary-pink);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

/* ---------- 购物车列表 ---------- */
.cart-list {
  padding: 20rpx 40rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  margin-bottom: 20rpx;
}

/* ---------- 自定义 Checkbox ---------- */
.custom-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--active-red);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.custom-checkbox.checked {
  background: var(--primary-pink);
  border-color: var(--primary-pink);
}

.check-icon {
  font-size: 24rpx;
  color: var(--white);
  font-weight: bold;
}

/* ---------- 商品图片 ---------- */
.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--btn-radius);
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* ---------- 商品信息 ---------- */
.item-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.item-core-spec {
  display: block;
  font-size: 24rpx;
  color: var(--text-dark);
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.item-extra-spec {
  display: block;
  font-size: 22rpx;
  color: var(--text-grey);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.item-price {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
  margin-top: auto;
}

/* ---------- 数量加减器 ---------- */
.quantity-stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--active-red);
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
}

.stepper-btn.minus {
  border-right: 2rpx solid var(--active-red);
}

.stepper-btn.plus {
  border-left: 2rpx solid var(--active-red);
}

.stepper-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
}

/* ---------- 推荐商品 ---------- */
.recommend-section {
  padding: 30rpx 40rpx 200rpx;
}

.recommend-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-line {
  flex: 1;
  height: 1rpx;
  background: var(--text-grey);
}

.header-title {
  font-size: 28rpx;
  color: var(--text-dark);
  padding: 0 20rpx;
  font-weight: bold;
}

.recommend-scroll {
  white-space: nowrap;
  width: 100%;
}

.recommend-card {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  overflow: visible;
  vertical-align: top;
}

.recommend-img-wrap {
  width: 200rpx;
  height: 200rpx;
  overflow: hidden;
}

.recommend-img {
  width: 100%;
  height: 100%;
}

.cart-icon-wrap {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--btn-radius);
  background: var(--primary-pink);
  border: 3rpx solid var(--active-red);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--retro-shadow);
  z-index: 1;
  flex-shrink: 0;
}

.cart-icon {
  font-size: 28rpx;
}

.recommend-name {
  display: block;
  font-size: 24rpx;
  color: var(--text-dark);
  padding: 12rpx 12rpx 6rpx;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 12rpx;
}

.recommend-price {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--active-red);
  text-align: left;
}

/* ---------- 吸底结算栏 ---------- */
.settlement-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: var(--border-thick);
  box-shadow: 0 -4rpx 12rpx rgba(122, 34, 56, 0.15);
}

.settlement-left {
  display: flex;
  align-items: center;
}

.settlement-total {
  font-size: 28rpx;
  color: var(--text-dark);
  margin-left: 20rpx;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
}

.settlement-btn {
  background: var(--active-red);
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  box-shadow: var(--retro-shadow);
}

.btn-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--white);
}

/* ---------- 规格选择弹窗 ---------- */
.spec-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.spec-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.spec-sheet {
  position: relative;
  background: var(--bg-main);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.spec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 20rpx;
  border-bottom: 2rpx solid rgba(226, 125, 154, 0.2);
  flex-shrink: 0;
}

.spec-product-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--active-red);
}

.spec-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--white);
  border: var(--border-thick);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: var(--text-grey);
  line-height: 1;
}

.spec-content {
  flex: 1;
  padding: 24rpx 40rpx;
  overflow-y: auto;
}

.spec-section {
  margin-bottom: 36rpx;
}

.spec-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--white);
  border: 3rpx solid #E8C8D4;
  border-radius: var(--btn-radius);
  min-width: 140rpx;
}

.spec-option.active {
  background: var(--primary-pink);
  border-color: var(--active-red);
}

.spec-option-name {
  font-size: 26rpx;
  color: var(--text-dark);
  margin-bottom: 4rpx;
}

.spec-option-price {
  font-size: 22rpx;
  color: var(--text-grey);
}

.spec-option.active .spec-option-name,
.spec-option.active .spec-option-price {
  color: var(--white);
}

.spec-footer {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: var(--border-thick);
  flex-shrink: 0;
}

.spec-total-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.spec-core-line {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.spec-extra-line {
  font-size: 22rpx;
  color: var(--text-grey);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spec-price-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.spec-total-label {
  font-size: 22rpx;
  color: var(--text-grey);
}

.spec-total-num {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
}

.spec-add-btn {
  background: var(--active-red);
  color: var(--white);
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: var(--retro-shadow);
}