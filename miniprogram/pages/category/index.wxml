<view class="category-page">
  <navigation-bar title="商品分类" />

  <view class="content">
    <!-- 分类栏 -->
    <scroll-view class="category-tabs" scroll-x enable-flex>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-tab {{selectedCategoryId === item.id ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 商品列表 -->
    <view class="products">
      <view wx:if="{{loading}}" class="loading">加载中...</view>

      <view wx:elif="{{products.length === 0}}" class="empty">
        <text>该分类暂无商品</text>
      </view>

      <view
        wx:for="{{products}}"
        wx:key="id"
        class="product-item"
        bindtap="onProductTap"
        data-id="{{item.id}}"
      >
        <image
          src="{{item.image || '/images/default-goods-image.png'}}"
          mode="aspectFill"
          class="product-image"
        />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <view class="product-price">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{formatPrice(item.price)}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>