<!-- pages/goods/goods.wxml -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索蛋糕..." placeholder-class="search-placeholder" value="{{searchText}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 左侧分类栏 + 右侧商品列表 -->
  <view class="category-layout">
    <!-- 左侧分类栏 -->
    <view class="category-sidebar">
      <view
        class="category-item {{activeCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 右侧商品列表 -->
    <scroll-view class="goods-scroll" scroll-y="true">
      <view class="goods-grid">
        <view class="goods-card clickable" wx:for="{{filteredGoods}}" wx:key="id">
          <view class="goods-img-wrap">
            <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
            <view class="stamp-sticker">
              <text>{{item.stampText}}</text>
            </view>
            <view class="cart-icon-wrap" catchtap="onAddToCart" data-id="{{item.id}}">
              <text class="cart-icon">🛒</text>
            </view>
          </view>
          <view class="goods-info">
            <text class="goods-name">{{item.name}}</text>
            <text class="goods-desc">{{item.desc}}</text>
            <text class="goods-price">¥{{item.price}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredGoods.length === 0}}">
        <text class="empty-text">暂无相关商品</text>
      </view>
    </scroll-view>
  </view>
</view>