<!-- pages/goods/goods.wxml -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索蛋糕..." placeholder-class="search-placeholder" value="{{searchText}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 左侧分类栏 + 右侧商品列表 -->
  <view class="category-layout">
    <!-- 左侧分类栏 -->
    <view class="category-sidebar">
      <view
        class="category-item {{activeCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 右侧商品列表 -->
    <scroll-view class="goods-scroll" scroll-y="true">
      <view class="goods-grid">
        <view class="goods-card clickable" wx:for="{{filteredGoods}}" wx:key="id">
          <view class="goods-img-wrap">
            <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
            <view class="stamp-sticker">
              <text>{{item.stampText}}</text>
            </view>
          </view>
          <view class="goods-info">
            <text class="goods-name">{{item.name}}</text>
            <text class="goods-desc">{{item.desc}}</text>
            <view class="goods-price-row">
              <text class="goods-price">¥{{item.price}}</text>
              <view class="cart-icon-wrap" catchtap="onCartIconTap" data-id="{{item.id}}">
                <text class="cart-icon">🛒</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredGoods.length === 0}}">
        <text class="empty-text">暂无相关商品</text>
      </view>
    </scroll-view>
  </view>

  <!-- 规格选择弹窗 -->
  <view class="spec-popup" wx:if="{{showSpecPopup}}">
    <view class="spec-mask" bindtap="onCloseSpecPopup"></view>
    <view class="spec-sheet">
      <!-- 顶部 -->
      <view class="spec-header">
        <text class="spec-product-name">{{currentItem.name}}</text>
        <view class="spec-close-btn" bindtap="onCloseSpecPopup">×</view>
      </view>

      <!-- 规格内容 -->
      <scroll-view class="spec-content" scroll-y="true">
        <!-- 份量 -->
        <view class="spec-section">
          <text class="spec-section-title">份量</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.size === item.name ? 'active' : ''}}"
              wx:for="{{specOptions.size}}"
              wx:key="name"
              data-spec="size"
              data-name="{{item.name}}"
              data-price="{{item.price}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item.name}}</text>
              <text class="spec-option-price" wx:if="{{item.price > 0}}">+¥{{item.price}}</text>
              <text class="spec-option-price" wx:else>¥{{item.price}}</text>
            </view>
          </view>
        </view>

        <!-- 夹心 -->
        <view class="spec-section">
          <text class="spec-section-title">夹心</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.filling === item ? 'active' : ''}}"
              wx:for="{{specOptions.filling}}"
              wx:key="*this"
              data-spec="filling"
              data-name="{{item}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 插牌/生日帽 -->
        <view class="spec-section">
          <text class="spec-section-title">插牌/生日帽</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.card === item ? 'active' : ''}}"
              wx:for="{{specOptions.card}}"
              wx:key="*this"
              data-spec="card"
              data-name="{{item}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 蜡烛 -->
        <view class="spec-section">
          <text class="spec-section-title">蜡烛</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.candle === item ? 'active' : ''}}"
              wx:for="{{specOptions.candle}}"
              wx:key="*this"
              data-spec="candle"
              data-name="{{item}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 贺卡 -->
        <view class="spec-section">
          <text class="spec-section-title">贺卡</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.mention === item ? 'active' : ''}}"
              wx:for="{{specOptions.mention}}"
              wx:key="*this"
              data-spec="mention"
              data-name="{{item}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 包装 -->
        <view class="spec-section">
          <text class="spec-section-title">包装</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.packaging === item.name ? 'active' : ''}}"
              wx:for="{{specOptions.packaging}}"
              wx:key="name"
              data-spec="packaging"
              data-name="{{item.name}}"
              data-price="{{item.price}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item.name}}</text>
              <text class="spec-option-price" wx:if="{{item.price > 0}}">+¥{{item.price}}</text>
              <text class="spec-option-price" wx:else>¥{{item.price}}</text>
            </view>
          </view>
        </view>

        <!-- 奶油加量 -->
        <view class="spec-section">
          <text class="spec-section-title">奶油加量</text>
          <view class="spec-options">
            <view
              class="spec-option {{selectedSpec.cream === item.name ? 'active' : ''}}"
              wx:for="{{specOptions.cream}}"
              wx:key="name"
              data-spec="cream"
              data-name="{{item.name}}"
              data-price="{{item.price}}"
              bindtap="onSpecOptionTap"
            >
              <text class="spec-option-name">{{item.name}}</text>
              <text class="spec-option-price" wx:if="{{item.price > 0}}">+¥{{item.price}}</text>
              <text class="spec-option-price" wx:else>¥{{item.price}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 底部价格+按钮 -->
      <view class="spec-footer">
        <view class="spec-total-info">
          <view class="spec-core-line">{{currentSpecCore}}</view>
          <view class="spec-extra-line">{{currentSpecExtra}}</view>
        </view>
        <view class="spec-price-wrap">
          <text class="spec-total-label">合计</text>
          <text class="spec-total-num">¥{{totalPrice}}</text>
        </view>
        <view class="spec-add-btn" bindtap="onConfirmAddToCart">加入购物车</view>
      </view>
    </view>
  </view>
</view>