/* pages/goods/goods.wxss */

/* ---------- 搜索框 ---------- */
.search-bar {
  padding: 24rpx 40rpx;
  background: var(--bg-main);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--white);
  border: 3rpx solid var(--active-red);
  border-radius: var(--btn-radius);
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-dark);
}

.search-placeholder {
  color: var(--text-grey);
  font-size: 28rpx;
}

/* ---------- 左侧分类栏 + 右侧商品列表 ---------- */
.category-layout {
  display: flex;
  height: calc(100vh - 120rpx - env(safe-area-inset-bottom));
}

/* 左侧分类栏 */
.category-sidebar {
  width: 25%;
  flex-shrink: 0;
  background: var(--white);
  border-right: var(--border-thick);
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--bg-main);
  background: var(--white);
  transition: background 0.2s;
}

.category-item.active {
  background: var(--bg-main);
  border-left: 6rpx solid var(--active-red);
}

.category-item.active .category-name {
  color: var(--active-red);
  font-weight: bold;
}

.category-name {
  font-size: 26rpx;
  color: var(--text-dark);
  text-align: center;
  padding: 0 8rpx;
}

/* 右侧商品列表 */
.goods-scroll {
  width: 75%;
  flex: 1;
  height: 100%;
}

/* ---------- 双列商品网格 ---------- */
.goods-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 24rpx;
  padding: 24rpx;
}

.goods-card {
  background: var(--white);
  border-radius: var(--card-radius);
  overflow: hidden;
  border: var(--border-thick);
  box-shadow: var(--retro-shadow);
}

.goods-img-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.goods-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 印章贴纸 */
.stamp-sticker {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-pink);
  border: 3rpx solid var(--active-red);
  display: flex;
  justify-content: center;
  align-items: center;
  transform: rotate(15deg);
}

.stamp-sticker text {
  font-size: 18rpx;
  font-weight: bold;
  color: var(--white);
}

/* 购物车小图标 */
.cart-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--btn-radius);
  background: var(--primary-pink);
  border: 3rpx solid var(--active-red);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--retro-shadow);
}

.cart-icon {
  font-size: 28rpx;
}

/* ---------- 商品信息 ---------- */
.goods-info {
  padding: 16rpx 20rpx 20rpx;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 6rpx;
  text-align: left;
}

.goods-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-grey);
  margin-bottom: 12rpx;
  text-align: left;
}

.goods-price {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
  text-align: left;
}

.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-grey);
}

/* ============================================
   规格选择弹窗
   ============================================ */
.spec-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.spec-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.spec-sheet {
  position: relative;
  background: var(--bg-main);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

/* 顶部标题栏 */
.spec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 20rpx;
  border-bottom: 2rpx solid rgba(226, 125, 154, 0.2);
  flex-shrink: 0;
}

.spec-product-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--active-red);
}

.spec-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--white);
  border: var(--border-thick);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: var(--text-grey);
  line-height: 1;
}

/* 规格内容区 */
.spec-content {
  flex: 1;
  padding: 24rpx 40rpx;
  overflow-y: auto;
}

/* 每个规格区块 */
.spec-section {
  margin-bottom: 36rpx;
}

.spec-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 16rpx;
}

.spec-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 单个选项 */
.spec-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--white);
  border: 3rpx solid #E8C8D4;
  border-radius: var(--btn-radius);
  min-width: 140rpx;
}

.spec-option.active {
  background: var(--primary-pink);
  border-color: var(--active-red);
}

.spec-option-name {
  font-size: 26rpx;
  color: var(--text-dark);
  margin-bottom: 4rpx;
}

.spec-option-price {
  font-size: 22rpx;
  color: var(--text-grey);
}

.spec-option.active .spec-option-name,
.spec-option.active .spec-option-price {
  color: var(--white);
}

/* 底部价格+按钮 */
.spec-footer {
  display: flex;
  align-items: center;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: var(--border-thick);
  flex-shrink: 0;
}

.spec-total-info {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.spec-core-line {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.spec-extra-line {
  font-size: 22rpx;
  color: var(--text-grey);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spec-price-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.spec-total-label {
  font-size: 22rpx;
  color: var(--text-grey);
}

.spec-total-num {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
}

.spec-add-btn {
  background: var(--active-red);
  color: var(--white);
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: var(--retro-shadow);
}