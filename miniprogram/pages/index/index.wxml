<view class="index-page">
  <navigation-bar title="蛋糕工作室" back="{{false}}" />

  <view class="content">
    <!-- Banner -->
    <view class="banner">
      <swiper indicator-dots autoplay circular>
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <image src="{{item.image}}" mode="aspectFill" class="banner-image" />
        </swiper-item>
      </swiper>
    </view>

    <!-- Categories -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">商品分类</text>
      </view>
      <view class="categories">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-item"
          bindtap="onCategoryTap"
          data-id="{{item.id}}"
        >
          <image src="{{item.icon || '/images/default-goods-image.png'}}" mode="aspectFill" class="category-icon" />
          <text class="category-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- Products -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">推荐商品</text>
      </view>
      <view class="products">
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="product-item"
          bindtap="onProductTap"
          data-id="{{item.id}}"
        >
          <image src="{{item.image || '/images/default-goods-image.png'}}" mode="aspectFill" class="product-image" />
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{formatPrice(item.price)}}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>
      <view wx:if="{{!loading && products.length === 0}}" class="empty">
        <text>暂无商品</text>
      </view>
    </view>
  </view>
</view>