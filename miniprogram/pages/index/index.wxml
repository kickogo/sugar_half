<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 顶部轮播区 -->
  <view class="swiper-section">
    <!-- 棋盘格背景平铺 -->
    <view class="checkerboard-bg"></view>

    <!-- 轮播图 -->
    <swiper class="main-swiper" circular="true" autoplay="true" interval="3000" duration="500">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="cake-wrapper">
          <view class="scalloped-border">
            <image class="cake-img" src="{{item.image}}" mode="aspectFill"></image>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- Jenny 品牌椭圆标签 -->
    <view class="jenny-brand">
      <text>Jenny</text>
    </view>
  </view>

  <!-- 客服小票 -->
  <view class="service-ticket">
    <view class="ticket-content">
      <view class="ticket-header">ONLINE SERVICE</view>
      <view class="ticket-body">客服小票</view>
      <view class="ticket-footer">在线咨询</view>
    </view>
  </view>

  <!-- 时令鲜果金刚位 -->
  <view class="fruit-section">
    <view class="fruit-left">
      <text class="fruit-title">时令鲜果</text>
      <text class="fruit-sub">Summer Fresh</text>
    </view>
    <view class="fruit-arrow">→</view>
  </view>

  <!-- 底部气泡框 -->
  <view class="bubble-section">
    <view class="bubble-card">
      <text class="bubble-text">查看全部蛋糕</text>
      <text class="bubble-arrow">›</text>
    </view>
  </view>
</view>