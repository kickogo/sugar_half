/* pages/index/index.wxss */

/* ============================================
   01 固定导航栏
   ============================================ */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-top: calc(16rpx + env(safe-area-inset-top));
  background: var(--white);
  border-bottom: var(--border-thick);
  box-shadow: 0 4rpx 12rpx rgba(122, 34, 56, 0.1);
}

.nav-logo {
  flex-shrink: 0;
  margin-right: 16rpx;
}

.nav-logo-text {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--active-red);
  white-space: nowrap;
}

.nav-search {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-main);
  border: 3rpx solid var(--active-red);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  margin: 0 16rpx;
}

.nav-search-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.nav-search-placeholder {
  font-size: 24rpx;
  color: var(--text-grey);
}

.nav-icons {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.nav-icon-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--bg-main);
  border: 3rpx solid var(--active-red);
  border-radius: 50%;
}

.nav-icon {
  font-size: 28rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--active-red);
  border-radius: 16rpx;
  color: var(--white);
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 6rpx;
}

/* ============================================
   页面主体（偏移导航栏高度）
   ============================================ */
.page-body {
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

/* ============================================
   02 首屏轮播Banner区
   ============================================ */
.banner-section {
  background: var(--bg-main);
  padding: 30rpx 0 60rpx;
  position: relative;
  z-index: 1;
  overflow: visible;
}

.banner-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.banner-swiper {
  height: 600rpx;
  width: 100%;
}

.banner-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  height: 600rpx;
  box-sizing: border-box;
}

.banner-cake-wrap {
  margin-bottom: 24rpx;
}

.banner-cake-border {
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: var(--white);
  box-shadow: 0 0 0 8rpx solid var(--primary-pink);
  padding: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.banner-cake-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.banner-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
  margin-bottom: 8rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  color: var(--text-grey);
  margin-bottom: 20rpx;
}

.banner-btn {
  background: var(--active-red);
  color: var(--white);
  font-size: 28rpx;
  font-weight: bold;
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: var(--retro-shadow);
}

/* ============================================
   03 快捷功能入口
   ============================================ */
.quick-entries {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx 40rpx 30rpx;
  position: relative;
  z-index: 2;
  background: var(--bg-main);
}

.quick-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  padding: 24rpx 0;
  box-shadow: var(--retro-shadow);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.quick-name {
  font-size: 24rpx;
  color: var(--text-dark);
  font-weight: bold;
}

.quick-note {
  font-size: 18rpx;
  color: var(--text-grey);
  margin-top: 4rpx;
  text-align: center;
  padding: 0 8rpx;
}

/* ============================================
   通用区块包装
   ============================================ */
.section-wrap {
  padding: 0 40rpx 30rpx;
}

.goods-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-grey);
}

.section-arrow {
  font-size: 28rpx;
  margin-left: 4rpx;
}

/* ============================================
   04 福利活动模块
   ============================================ */
.welfare-card {
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  padding: 28rpx 32rpx;
}

.welfare-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.welfare-dot {
  color: var(--primary-pink);
  font-size: 32rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.welfare-text {
  font-size: 28rpx;
  color: var(--text-dark);
}

.welfare-btn {
  background: var(--active-red);
  color: var(--white);
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  padding: 18rpx;
  border-radius: 40rpx;
  margin-top: 24rpx;
  box-shadow: var(--retro-shadow);
}

/* ============================================
   05A/B 商品横向滚动区
   ============================================ */
.product-scroll {
  display: flex;
  white-space: nowrap;
  padding-bottom: 20rpx;
}

.product-card {
  display: inline-block;
  width: 240rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  overflow: hidden;
}

.product-img-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.product-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-pink);
  border: 3rpx solid var(--active-red);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  font-weight: bold;
  color: var(--white);
}

.new-tag {
  background: var(--active-red);
}

.product-info {
  padding: 16rpx;
}

.product-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 4rpx;
}

.product-spec {
  display: block;
  font-size: 22rpx;
  color: var(--text-grey);
  margin-bottom: 8rpx;
}

.product-price {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--active-red);
}

/* ============================================
   05C 场景化推荐
   ============================================ */
.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 20rpx;
}

.scene-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  padding: 28rpx 0;
  box-shadow: var(--retro-shadow);
}

.scene-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.scene-name {
  font-size: 24rpx;
  color: var(--text-dark);
  font-weight: bold;
}

/* ============================================
   06 品牌信任背书
   ============================================ */
.trust-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  padding: 24rpx 16rpx;
  box-shadow: var(--retro-shadow);
}

.trust-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.trust-text {
  font-size: 24rpx;
  color: var(--text-dark);
  font-weight: bold;
  text-align: center;
}

/* ============================================
   07 用户评价区
   ============================================ */
.review-scroll {
  display: flex;
  white-space: nowrap;
  padding-bottom: 20rpx;
}

.review-card {
  display: inline-block;
  width: 320rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  padding: 24rpx;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-main);
  border: 3rpx solid var(--primary-pink);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.review-user {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.review-nickname {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 4rpx;
}

.review-stars {
  display: flex;
}

.star-icon {
  font-size: 22rpx;
}

.review-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-dark);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.review-product {
  display: block;
  font-size: 22rpx;
  color: var(--text-grey);
}

/* ============================================
   08 门店信息
   ============================================ */
.store-card {
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
  padding: 28rpx 32rpx;
}

.store-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
}

.store-map-btn {
  display: flex;
  align-items: center;
  background: var(--active-red);
  color: var(--white);
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.store-info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.store-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.store-address,
.store-hours,
.store-service {
  font-size: 26rpx;
  color: var(--text-dark);
  line-height: 1.5;
  flex: 1;
}