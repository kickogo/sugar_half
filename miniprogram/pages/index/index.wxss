/* pages/index/index.wxss */

/* ---------- 顶部轮播区 ---------- */
.swiper-section {
  position: relative;
  height: 480rpx;
  overflow: hidden;
}

/* 棋盘格背景平铺 */
.checkerboard-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(45deg, #FFDDE8 25%, transparent 25%),
    linear-gradient(-45deg, #FFDDE8 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #FFDDE8 75%),
    linear-gradient(-45deg, transparent 75%, #FFDDE8 75%);
  background-size: 40rpx 40rpx;
  background-position: 0 0, 0 20rpx, 20rpx -20rpx, -20rpx 0rpx;
  background-color: #FFF2F5;
}

/* 主轮播 */
.main-swiper {
  position: relative;
  height: 480rpx;
  width: 100%;
}

.cake-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

/* 贝壳形边框 */
.scalloped-border {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: #FFF;
  box-shadow: 0 0 0 8rpx solid #E27D9A;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.cake-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* Jenny 品牌椭圆标签 */
.jenny-brand {
  position: absolute;
  left: 50%;
  bottom: -30rpx;
  transform: translateX(-50%);
  background: var(--white);
  border: var(--border-thick);
  border-radius: 40rpx;
  padding: 10rpx 40rpx;
  box-shadow: var(--retro-shadow);
  z-index: 10;
}

.jenny-brand text {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--active-red);
  letter-spacing: 4rpx;
}

/* ---------- 客服小票 ---------- */
.service-ticket {
  margin: 80rpx 40rpx 30rpx;
  transform: rotate(-2.5deg);
}

.ticket-content {
  background: linear-gradient(180deg, #FFDDE8 0%, #FFDDE8 100%);
  border-radius: 16rpx;
  border: var(--border-thick);
  box-shadow: var(--retro-shadow);
  padding: 24rpx 32rpx;
  position: relative;
}

/* 上边锯齿效果 */
.ticket-content::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 0;
  right: 0;
  height: 12rpx;
  background: linear-gradient(135deg, transparent 50%, var(--white) 50%) -10rpx 0,
              linear-gradient(-135deg, transparent 50%, var(--white) 50%) -10rpx 0,
              linear-gradient(45deg, transparent 50%, var(--white) 50%) -10rpx 0,
              linear-gradient(-45deg, transparent 50%, var(--white) 50%) -10rpx 0;
  background-size: 20rpx 12rpx;
  background-repeat: repeat-x;
}

/* 下边锯齿效果 */
.ticket-content::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 0;
  right: 0;
  height: 12rpx;
  background: linear-gradient(135deg, var(--white) 50%, transparent 50%) -10rpx 0,
              linear-gradient(-135deg, var(--white) 50%, transparent 50%) -10rpx 0,
              linear-gradient(45deg, var(--white) 50%, transparent 50%) -10rpx 0,
              linear-gradient(-45deg, var(--white) 50%, transparent 50%) -10rpx 0;
  background-size: 20rpx 12rpx;
  background-repeat: repeat-x;
}

.ticket-header {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--active-red);
  letter-spacing: 2rpx;
  text-align: center;
  padding-bottom: 8rpx;
  border-bottom: 2rpx dashed var(--active-red);
}

.ticket-body {
  font-size: 32rpx;
  color: var(--text-dark);
  text-align: center;
  padding: 16rpx 0;
}

.ticket-footer {
  font-size: 24rpx;
  color: var(--primary-pink);
  text-align: center;
}

/* ---------- 时令鲜果金刚位 ---------- */
.fruit-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 40rpx 30rpx;
  padding: 24rpx 32rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
}

.fruit-left {
  display: flex;
  flex-direction: column;
}

.fruit-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
}

.fruit-sub {
  font-size: 22rpx;
  color: var(--text-grey);
  margin-top: 4rpx;
}

.fruit-arrow {
  font-size: 48rpx;
  color: var(--active-red);
  font-weight: bold;
}

/* ---------- 底部气泡框 ---------- */
.bubble-section {
  margin: 0 40rpx;
}

.bubble-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--white);
  border: var(--border-thick);
  border-radius: var(--card-radius);
  box-shadow: var(--retro-shadow);
}

.bubble-text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--active-red);
}

.bubble-arrow {
  font-size: 48rpx;
  color: var(--active-red);
}