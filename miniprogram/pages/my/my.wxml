<!-- pages/my/my.wxml -->
<view class="container">
  <!-- 顶部大桥插画背景 -->
  <view class="header-bg">
    <image class="bridge-illustration" src="{{backgroundUrl}}" mode="aspectFill"></image>
    <view class="user-info">
      <view class="avatar-placeholder">
        <text class="avatar-text">静</text>
      </view>
      <text class="username">甜序</text>
    </view>
  </view>

  <!-- VIP 会员卡 -->
  <view class="vip-card">
    <view class="vip-left">
      <text class="vip-title">甜序会员卡</text>
      <text class="vip-subtitle">VIP Member</text>
      <view class="vip-benefits">
        <text class="benefit-item">✓ 生日专属蛋糕8折</text>
        <text class="benefit-item">✓ 优先配送</text>
        <text class="benefit-item">✓ 积分双倍</text>
      </view>
    </view>
    <view class="vip-right">
      <text class="vip-level">金卡</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item clickable" wx:for="{{menuItems}}" wx:key="id">
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>