/* pages/payment/index.wxss */
.payment-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.content {
  padding: 30rpx;
}

.amount-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.amount-value {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.currency {
  font-size: 36rpx;
  color: #ff6b6b;
}

.money {
  font-size: 72rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.status-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  margin-bottom: 30rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 32rpx;
  color: #333;
}

.status-item.success .status-icon {
  color: #52c41a;
}

.status-item.success .status-text {
  color: #52c41a;
}

.status-item.fail .status-icon {
  color: #ff4d4f;
}

.status-item.fail .status-text {
  color: #ff4d4f;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f5f5f5;
  border-top-color: #ff6b6b;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.actions {
  margin-top: 40rpx;
}

.action-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 32rpx;
}

.action-btn.primary {
  background: #ff6b6b;
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}