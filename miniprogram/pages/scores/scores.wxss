/* pages/scores/scores.wxss */

/* ---------- 积分商城页面背景 ---------- */
.scores-page {
  background: #F8E8EE;
  min-height: 100vh;
}

/* ---------- Rewards 装饰头部 ---------- */
.rewards-header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  overflow: hidden;
}

.rewards-bg-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 200rpx;
  font-weight: bold;
  color: rgba(241, 120, 182, 0.15);
  white-space: nowrap;
  pointer-events: none;
  letter-spacing: 10rpx;
}

.rewards-title {
  position: relative;
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #F178B6;
  margin-bottom: 12rpx;
}

.rewards-subtitle {
  position: relative;
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.user-scores {
  position: relative;
  display: inline-block;
  font-size: 28rpx;
  color: #F178B6;
  font-weight: bold;
  background: rgba(241, 120, 182, 0.1);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F178B6;
}

/* ---------- 代金券网格 ---------- */
.coupon-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 24rpx;
  padding: 0 30rpx 40rpx;
}

/* ---------- 代金券卡片 ---------- */
.coupon-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ---------- 代金券图片 ---------- */
.coupon-img-wrap {
  width: 100%;
  padding-bottom: 66%;
  position: relative;
  overflow: hidden;
}

.coupon-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 代金券信息 ---------- */
.coupon-info {
  padding: 16rpx 16rpx 12rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.coupon-title {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  text-align: center;
}

.coupon-points {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.points-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #F178B6;
}

.points-label {
  font-size: 20rpx;
  color: #999999;
  margin-left: 4rpx;
}

/* ---------- 加号按钮 ---------- */
.exchange-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F178B6;
  display: flex;
  justify-content: center;
  align-items: center;
  align-self: flex-end;
  margin: 8rpx 12rpx 12rpx;
}

.exchange-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  line-height: 1;
}