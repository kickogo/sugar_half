/* pages/scores/scores.wxss */

/* ---------- Rewards 装饰头部 ---------- */
.rewards-header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  overflow: hidden;
}

.rewards-bg-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 200rpx;
  font-weight: bold;
  color: rgba(226, 125, 154, 0.12);
  white-space: nowrap;
  pointer-events: none;
  letter-spacing: 10rpx;
}

.rewards-title {
  position: relative;
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: var(--active-red);
  margin-bottom: 12rpx;
}

.rewards-subtitle {
  position: relative;
  display: block;
  font-size: 26rpx;
  color: var(--text-grey);
}

/* ---------- 代金券网格 ---------- */
.coupon-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 24rpx;
  padding: 0 30rpx 40rpx;
}

.coupon-card {
  background: var(--white);
  border-radius: var(--card-radius);
  overflow: hidden;
  border: var(--border-thick);
  box-shadow: var(--retro-shadow);
  display: flex;
  flex-direction: column;
}

.coupon-img-wrap {
  width: 100%;
  padding-bottom: 65%;
  position: relative;
  overflow: hidden;
}

.coupon-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.coupon-info {
  padding: 16rpx 20rpx 12rpx;
  flex: 1;
}

.coupon-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-dark);
  margin-bottom: 10rpx;
  text-align: left;
}

.coupon-points {
  display: flex;
  align-items: baseline;
}

.points-num {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--active-red);
}

.points-label {
  font-size: 22rpx;
  color: var(--text-grey);
  margin-left: 4rpx;
}

/* ---------- 兑换按钮 ---------- */
.exchange-btn {
  margin: 0 20rpx 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-pink);
  border: var(--border-thick);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: var(--retro-shadow);
  align-self: flex-end;
}

.exchange-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--white);
  line-height: 1;
}